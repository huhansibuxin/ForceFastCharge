<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>强制快充</string>
	<key>items</key>
	<array>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>强制快充</string>
			<key>footerText</key><string>阻止系统把充电电流/功率上限往下压（ChargeCurrentLimit、MaxChargeCurrent、AdapterPowerLimit、USBPD* 等），让充电速度由充电器协商与电池 BMS 决定。不修改电池状态、不解除原厂温度保护。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>forceChargeEnabled</string>
			<key>label</key><string>强制快充</string>
		</dict>

		<!-- ===================== 指示点 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>状态指示点</string>
			<key>footerText</key><string>圆点的唯一作用：判断强制快充到底有没有在起作用 —— 我们真在拦系统降流时亮红点。绿点 = 系统原生充电（我们没介入，系统自己就充得很好），不充电时一律不显示。判据不是「开关开没开」（开关常开），而是「这一轮充电有没有真的拦到降流」。圆点只覆盖自身 24×24 区域、不接收触摸，不影响系统手势。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSegmentCell</string>
			<key>default</key><integer>2</integer>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>indicatorShowMode</string>
			<key>label</key><string>显示模式</string>
			<key>validTitles</key><array><string>仅强制</string><string>常显</string></array>
			<key>validValues</key><array><integer>2</integer><integer>1</integer></array>
		</dict>
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>footerText</key><string>仅强制（默认）：只有我们真在拦降流时才亮红点 —— 圆点即「插件是否在起作用」的唯一判断点。常显：只要在充电就显示（我们没干活时是绿点，表示系统自己充得很好）。两个模式在没充电时都不显示。</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>圆点位置</string>
			<key>footerText</key><string>以 pt 为单位、指圆点中心，实机屏幕宽 393 / 高 852。默认 X=294 Y=29.4（灵动岛右侧、与系统绿点同水平线，测试机型 iPhone 14 Pro Max）。直接输入数字，收起键盘即保存并立即移动圆点；填 0 或留空则回退默认值。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>default</key><string>294</string>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>dotX</string>
			<key>label</key><string>横坐标 X</string>
			<key>keyboardType</key><integer>8</integer>
		</dict>
		<dict>
			<key>cell</key><string>PSEditTextCell</string>
			<key>default</key><string>29.4</string>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>dotY</string>
			<key>label</key><string>纵坐标 Y</string>
			<key>keyboardType</key><integer>8</integer>
		</dict>
		<dict>
			<key>cell</key><string>PSButtonCell</string>
			<key>label</key><string>立即应用位置</string>
			<key>action</key><string>applyDotPosition</string>
		</dict>

		<!-- ===================== 运行状态 ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>运行状态</string>
			<key>footerText</key><string>「powerd 已加载」= 强制快充核心（吞降流）有没有注入成功；「是否在干活」= 本轮充电有没有真的拦到系统降流（红点判据）；「已拦截降流次数」累计增长代表确实在拦。「圆点当前状态」是此刻圆点应该显示的样子，不必盯着状态栏核对。若显示未加载，SSH 查 /var/mobile/Documents/ForceFastCharge/boot.log 与 sb.log。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSValueCell</string>
			<key>defaults</key><string>com.chargecontrol.ffstatus</string>
			<key>key</key><string>loaded</string>
			<key>label</key><string>powerd 已加载</string>
		</dict>
		<dict>
			<key>cell</key><string>PSValueCell</string>
			<key>defaults</key><string>com.chargecontrol.ffstatus</string>
			<key>key</key><string>active</string>
			<key>label</key><string>强制快充是否在干活</string>
		</dict>
		<dict>
			<key>cell</key><string>PSValueCell</string>
			<key>defaults</key><string>com.chargecontrol.ffstatus</string>
			<key>key</key><string>blocked</string>
			<key>label</key><string>已拦截降流次数</string>
		</dict>
		<dict>
			<key>cell</key><string>PSValueCell</string>
			<key>defaults</key><string>com.chargecontrol.sbstatus</string>
			<key>key</key><string>dotLoaded</string>
			<key>label</key><string>指示器已加载</string>
		</dict>
		<dict>
			<key>cell</key><string>PSValueCell</string>
			<key>defaults</key><string>com.chargecontrol.sbstatus</string>
			<key>key</key><string>dotWindow</string>
			<key>label</key><string>圆点窗口</string>
		</dict>
		<dict>
			<key>cell</key><string>PSValueCell</string>
			<key>defaults</key><string>com.chargecontrol.sbstatus</string>
			<key>key</key><string>dotState</string>
			<key>label</key><string>圆点当前状态</string>
		</dict>

		<!-- ===================== 高温强制（高风险，默认关） ===================== -->
		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>高温强制</string>
			<key>footerText</key><string>⚠️ 高风险：上面「强制快充」只拦系统软件层降流，机身过热时 iOS 仍会通过温控派生键（ThermalMaxChargeCurrent 等）停止充电——这是原厂安全保护。打开本开关会一并吞掉温控指令，设备将不再自行停止充电，可能因过热触发强制关机（黑屏）并加速电池老化。仅在你明确接受该风险时开启。</string>
		</dict>
		<dict>
			<key>cell</key><string>PSSwitchCell</string>
			<key>default</key><false/>
			<key>defaults</key><string>com.chargecontrol</string>
			<key>key</key><string>forceThermalOverrideEnabled</string>
			<key>label</key><string>强制覆盖温控降流（可能黑屏）</string>
		</dict>

		<dict>
			<key>cell</key><string>PSGroupCell</string>
			<key>label</key><string>效果边界</string>
			<key>footerText</key><string>充电速度最终由充电器额定功率、线材规格、电池 BMS 与机身温度共同决定。本插件只保证「系统不主动往下压电流上限」，无法突破充电器功率天花板。诊断日志：/var/mobile/Documents/ForceFastCharge/（boot.log / ffcharge.log / sb.log，安装或升级时自动清除）。</string>
		</dict>
	</array>
</dict>
</plist>
